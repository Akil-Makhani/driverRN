{
  "expo": {
    "name": "BST Driver",
    "slug": "driverRN",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon/app_logo.png",
    "scheme": "bstdriver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bst.bstdriver",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera so you can photograph the weight slip and invoice for a trip.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library so you can attach the weight slip and invoice for a trip.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to give you driving directions to the pickup and delivery addresses for a trip.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app records your location while you are on duty so the office can see the vehicle's route for a trip.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "8"
    },
    "android": {
      "package": "com.bst.driver",
      "versionCode": 15,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon/adaptive_foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash_logo_square.png",
          "imageWidth": 300
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app accesses your photo library so you can attach the weight slip and invoice for a trip.",
          "cameraPermission": "This app uses the camera so you can photograph the weight slip and invoice for a trip.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to give you driving directions to the pickup and delivery addresses for a trip.",
          "locationAlwaysAndWhenInUsePermission": "This app records your location while you are on duty so the office can see the vehicle's route for a trip.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon/notification_icon.png",
          "color": "#004B64"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4dc032d4-d6c5-46b9-9599-c7a7aa8f94fa"
      }
    },
    "owner": "webminiindia"
  }
}

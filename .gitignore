node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
/android
/ios
# Gradle output of local Expo modules (/android above only matches the root
# folder, so modules/<name>/android is tracked — only its build output is not)
modules/*/android/build/
modules/*/android/.cxx/
# firebase/ holds google-services.json + GoogleService-Info.plist, required to
# build. They contain no secrets (the API keys are client identifiers), so they
# are committed — matching how the Flutter project shipped them.
expo-env.d.ts

# Local API overrides — machine-specific, never committed.
.env
.env.local

# Release signing key and its passwords. Losing these locks you out of Play
# updates forever; committing them lets anyone publish as you.
credentials/
*.jks
*.keystore
credentials.json

# Local-only copy of a .env value, kept while pointing the app elsewhere.
.env.local-backup
